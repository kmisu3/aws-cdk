{
  "name": "cdk-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome check .",
    "check": "npm run build && npm run quality && npm test && cdk synth --lookups=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "aws-cdk": "2.1145.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
